# ---------------------------------------------------------------------------
# Backend environment — copy to `.env` for local development.
# On Render these are set in the service dashboard (see DEPLOYMENT.md).
# Do NOT commit your real `.env` (it is gitignored).
# ---------------------------------------------------------------------------

NODE_ENV=development
# Do not set PORT in production: Render injects it.
PORT=5000

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/ecom
# Atlas example:
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ecom?retryWrites=true&w=majority

# --- URLs / CORS ------------------------------------------------------------
# Comma-separated list is allowed, e.g. "https://a.com,https://www.a.com"
FRONTEND_URL=http://localhost:3001
# Public base URL used when building links to uploaded files
API_BASE_URL=http://localhost:5000
# Only enable behind real TLS termination with a working proxy header
HTTPS_ENABLED=false

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-generate-a-strong-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
MFA_ISSUER=E-Commerce Platform
ADMIN_REGISTRATION_SECRET=change-me
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# --- Redis (optional — the API runs without it) ------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- reCAPTCHA --------------------------------------------------------------
RECAPTCHA_SECRET_KEY=

# --- Razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket -------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

# --- Optional integrations --------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# MSG91_API_KEY=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# --- Background jobs (defaults are fine) ------------------------------------
PAYMENT_SWEEP_ENABLED=true
SHIPROCKET_SYNC_ENABLED=true
