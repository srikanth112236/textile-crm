{
  "name": "mentoos-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "dev:web": "node scripts/dev-web.js",
    "proxy": "node scripts/cors-proxy.js",
    "build:web": "expo export --platform web --output-dir dist-web",
    "serve:web": "node scripts/serve-export.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report test-results/html",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "node scripts/dev-web.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo node_modules"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~56.0.13",
    "expo-constants": "~56.0.19",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.13",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.12",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.27",
    "expo-splash-screen": "~56.0.11",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "~19.2.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
