# ---------------------------------------------------------------------------
# Frontend environment — copy to `.env.local` for local development.
# On Render these are set in the service dashboard (see DEPLOYMENT.md).
# ---------------------------------------------------------------------------

NODE_ENV=production

# Backend API URL.
# NOTE: inlined into the browser bundle at BUILD time, so it must be correct
# before `next build` runs (Render: set it on the service, then redeploy with
# "Clear build cache & deploy" after changing it).
NEXT_PUBLIC_API_URL=https://textile-crm-backend.onrender.com

# NextAuth
NEXTAUTH_URL=https://textile-crm-frontend.onrender.com
NEXTAUTH_SECRET=change-me-generate-a-strong-random-secret

# Google reCAPTCHA v3 (public site key — note the NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Public site URL — used for sitemap.xml / robots.txt generation
SITE_URL=https://textile-crm-frontend.onrender.com

# Analytics / SEO (all optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GSC_VERIFICATION=
