# Server Configuration
NODE_ENV=production

# Backend API URL (set to your Render backend URL)
NEXT_PUBLIC_API_URL=https://ecom-backend.onrender.com

# NextAuth
NEXTAUTH_SECRET=<generate-a-strong-secret>
NEXTAUTH_URL=https://ecom-frontend.onrender.com

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<your-site-key>

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=<your-key-id>

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GSC_VERIFICATION=
# SITE_URL=https://ecom-frontend.onrender.com
