# Environment Variables Example for Textile CRM

# Server Port (Render sets this automatically to 10000)
PORT=5000

# MongoDB Connection String (Replace with your MongoDB Atlas URI for production)
# Example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/textile-crm?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/textile

# Secret Key for JWT authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here
