# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Configuration (use MongoDB Atlas or Render MongoDB)
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/ecom?retryWrites=true&w=majority

# Redis Configuration (use Render Redis or Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=<generate-a-strong-secret>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (for CORS - set to your Render frontend URL)
FRONTEND_URL=https://ecom-frontend.onrender.com

# Google reCAPTCHA v3
RECAPTCHA_SECRET_KEY=<your-secret-key>
RECAPTCHA_SITE_KEY=<your-site-key>

# MFA Configuration
MFA_ISSUER=E-Commerce Platform

# Security
HTTPS_ENABLED=true

# NextAuth Secret
NEXTAUTH_SECRET=<generate-a-strong-secret>
NEXTAUTH_URL=https://ecom-frontend.onrender.com

# Razorpay
RAZORPAY_KEY_ID=<your-key-id>
RAZORPAY_KEY_SECRET=<your-key-secret>
RAZORPAY_MERCHANT_ID=<your-merchant-id>
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>

# Stripe (optional)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# AWS S3 (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Elasticsearch (optional)
# ELASTICSEARCH_NODE=

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
